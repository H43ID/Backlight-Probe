<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HpBacklightProbe</AssemblyName>
    <RootNamespace>HpBacklightProbe</RootNamespace>
    <StartupObject>HpBacklightProbe.Program</StartupObject>
    <!-- This tool only makes sense on Windows (WMI), so we pin the TFM to -windows -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
