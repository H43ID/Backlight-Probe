<Window x:Class="HpBacklightProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP Keyboard Backlight Controller"
        Height="820" Width="960"
        MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Display, sans-serif">

    <!-- Root: decorative glow layer behind, real content on top -->
    <Grid>

        <!-- ============ AURORA GLOW BACKDROP ============ -->
        <!-- Large, heavily-blurred color blobs. Nothing here is interactive - it just
             gives the frosted glass cards behind/above it something colorful to "pick up",
             which is what sells the glass look without needing real OS-level backdrop blur. -->
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Canvas.Left="-160" Canvas.Top="-180" Opacity="0.30">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9C7A44" Offset="0" />
                        <GradientStop Color="#009C7A44" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="480" Height="480" Canvas.Right="-140" Canvas.Top="-120" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6B655C" Offset="0" />
                        <GradientStop Color="#006B655C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="440" Height="440" Canvas.Left="120" Canvas.Bottom="-220" Opacity="0.20">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4A4038" Offset="0" />
                        <GradientStop Color="#004A4038" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Admin Warning (if needed) -->
                <RowDefinition Height="*" />    <!-- Main Content -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="4,0,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource GlassChip}" BorderBrush="{StaticResource AccentViolet}" Margin="0,0,10,0">
                            <TextBlock Text="⚡ HP WMI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}" />
                        </Border>
                        <TextBlock x:Name="TxtTitleHeader" Text="HP Keyboard Backlight Controller" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock x:Name="TxtHardwareSummary" Text="Loading hardware info..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeAdmin" Style="{StaticResource GlassChip}" BorderBrush="{StaticResource SuccessGreen}" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtAdminStatus" Text="🛡️ Admin: Active" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" />
                    </Border>
                    <Button Content="🔄 Refresh" Style="{StaticResource PresetBtnStyle}" Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>

            <!-- Admin Warning Banner (Hidden by default unless not elevated) -->
            <Border x:Name="BannerAdminWarning" Grid.Row="1" Style="{StaticResource GlassCard}"
                    BorderBrush="{StaticResource ErrorRed}" Padding="14,10" CornerRadius="14" Margin="4,0,4,16"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Administrator Privileges Required" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" />
                        <TextBlock Text="Hardware communication with HP BIOS WMI requires running as Administrator to apply changes." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Body -->
            <Grid Grid.Row="2" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="360" />
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls & Preview -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <StackPanel Orientation="Vertical">

                        <!-- Master Power & Simulation Card -->
                        <Border Style="{StaticResource GlassCard}" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Backlight Power" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtPowerStateSubtitle" Text="Status: Unknown" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnMasterPower" Grid.Column="1" Content="ON / OFF" Style="{StaticResource ActionBtnStyle}" Width="120" Height="38" Click="BtnMasterPower_Click" />
                                </Grid>

                                <!-- Keyboard Glow Preview Visualizer -->
                                <Border x:Name="KbdPreviewBorder" Background="#22000018" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1" CornerRadius="14" Height="116" Margin="0,0,0,12" Padding="14">
                                    <Grid>
                                        <Rectangle x:Name="GlowRect" Fill="{StaticResource AccentGradient}" Opacity="0.5" RadiusX="10" RadiusY="10">
                                            <Rectangle.Effect>
                                                <BlurEffect Radius="30" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="⌨️ KEYBOARD BACKLIGHT SIMULATOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock x:Name="TxtPreviewPercent" Text="50% BRIGHTNESS" FontSize="21" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Brightness Slider Control -->
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Brightness Level" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtSliderPercent" Text="50%" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="SliderBrightness" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderBrightness_ValueChanged" />
                                </StackPanel>

                                <!-- Quick Presets -->
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="Quick Presets" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="5">
                                        <Button Content="Off (0%)" Style="{StaticResource PresetBtnStyle}" Click="BtnPreset_Click" Tag="0" />
                                        <Button Content="25%" Style="{StaticResource PresetBtnStyle}" Click="BtnPreset_Click" Tag="25" />
                                        <Button Content="50%" Style="{StaticResource PresetBtnStyle}" Click="BtnPreset_Click" Tag="50" />
                                        <Button Content="75%" Style="{StaticResource PresetBtnStyle}" Click="BtnPreset_Click" Tag="75" />
                                        <Button Content="100%" Style="{StaticResource PresetBtnStyle}" Click="BtnPreset_Click" Tag="100" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Lighting Effects Card -->
                        <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✨ Dynamic Lighting Effects" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Hardware-synchronized animation modes" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="BadgeActiveEffect" Style="{StaticResource GlassChip}" BorderBrush="{StaticResource AccentCyan}">
                                        <TextBlock x:Name="TxtActiveEffectBadge" Text="Mode: Static" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                                    </Border>
                                </Grid>

                                <!-- Effect Selection Buttons -->
                                <WrapPanel Margin="0,0,0,14">
                                    <Button x:Name="BtnEffectStatic" Content="💡 Static" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="Static" />
                                    <Button x:Name="BtnEffectBreathing" Content="🫁 Breathing" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="Breathing" />
                                    <Button x:Name="BtnEffectPulse" Content="💓 Pulse" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="Pulse" />
                                    <Button x:Name="BtnEffectTyping" Content="⌨️ Typing Pulse" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="TypingPulse" />
                                    <Button x:Name="BtnEffectSlowFade" Content="🌊 Slow Fade" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="SlowFade" />
                                    <Button x:Name="BtnEffectFlash" Content="⚡ Flash" Style="{StaticResource EffectBtnStyle}" Click="BtnEffectMode_Click" Tag="NotificationFlash" />
                                </WrapPanel>

                                <!-- Effect Parameter Adjustment Panel -->
                                <Border Background="#1A000000" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <!-- Speed / Cycle Slider -->
                                        <StackPanel x:Name="PanelSpeedControl" Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Speed / Cycle Duration" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock x:Name="TxtSpeedVal" Text="2.5s cycle" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderSpeed" Style="{StaticResource GlassSlider}" Minimum="0.5" Maximum="6.0" Value="2.5" SmallChange="0.1" ValueChanged="SliderSpeed_ValueChanged" />
                                        </StackPanel>

                                        <!-- Min/Max Intensity Sliders -->
                                        <Grid x:Name="PanelIntensityRange" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Min Brightness -->
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Min Brightness" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock x:Name="TxtMinVal" Text="5%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="SliderMinBrightness" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="50" Value="5" ValueChanged="SliderMinBrightness_ValueChanged" />
                                            </StackPanel>
                                            <!-- Max Brightness -->
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Max Brightness" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock x:Name="TxtMaxVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="SliderMaxBrightness" Style="{StaticResource GlassSlider}" Minimum="50" Maximum="100" Value="100" ValueChanged="SliderMaxBrightness_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Flash Specific Action -->
                                        <Grid x:Name="PanelFlashActions" Margin="0,6,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Flashes:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="1x" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnFlashCount_Click" Tag="1" />
                                                <Button Content="2x" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnFlashCount_Click" Tag="2" />
                                                <Button Content="3x" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnFlashCount_Click" Tag="3" />
                                                <Button Content="5x" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnFlashCount_Click" Tag="5" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⚡ Trigger Flash" Style="{StaticResource ActionBtnStyle}" Height="32" Padding="14,0" Click="BtnTriggerFlash_Click" />
                                        </Grid>

                                        <!-- Slow Fade Specific Presets -->
                                        <Grid x:Name="PanelSlowFadeActions" Margin="0,6,0,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Fade Target:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="0%" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnSlowFadeTarget_Click" Tag="0" />
                                                <Button Content="30%" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnSlowFadeTarget_Click" Tag="30" />
                                                <Button Content="70%" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnSlowFadeTarget_Click" Tag="70" />
                                                <Button Content="100%" Style="{StaticResource PresetBtnStyle}" Padding="10,4" Margin="2,0" Click="BtnSlowFadeTarget_Click" Tag="100" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Typing Pulse Status Indicator -->
                                        <TextBlock x:Name="TxtTypingPulseHint" Text="🟢 Reactive Hook Active — Type on your keyboard to test the pulse!" FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fast Actions Card -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Content="💡 Toggle Light" Style="{StaticResource PresetBtnStyle}" Click="BtnToggle_Click" Margin="0,0,8,8" />
                                    <Button Content="🔍 Run Diagnostic Probe" Style="{StaticResource PresetBtnStyle}" Click="BtnRunProbe_Click" Margin="0,0,8,8" />
                                    <Button Content="📋 Copy Status" Style="{StaticResource PresetBtnStyle}" Click="BtnCopyStatus_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Hardware Details & Live Diagnostic Log -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hardware Specs Card -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Firmware &amp; WMI Specs" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Keyboard Type:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="TxtKbdType" Text="Single-Zone White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="WMI Provider:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="hpqBIntM (root\wmi)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Lighting Support:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="TxtLightingSupport" Text="Supported (0x06 0x3D)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource SuccessGreen}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Raw State Byte:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="TxtRawState" Text="0x03" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Raw Brightness:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="TxtRawBrightness" Text="0x80 (128)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentCyan}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activity & Diagnostic Log -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Activity Log" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />

                            <Border Grid.Row="1" Background="#26000010" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1" CornerRadius="10">
                                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" FontFamily="Consolas, monospace" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
                            </Border>

                            <Button Grid.Row="2" Content="Clear Log" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,5" FontSize="11" Click="BtnClearLog_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="14,8" Margin="4,16,4,0">
                <Grid>
                    <TextBlock x:Name="TxtFooterStatus" Text="Ready." FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="v1.1.0 (Phase 1)" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
